{
  "name": "node-rocketsms",
  "version": "0.2.2",
  "description": "Modern RocketSMS SMS-gateway API.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage",
    "coverage:report": "jest --coverage --coverageReporters=text-lcov && open coverage/lcov-report/index.html"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yauhenipakala/node-rocketsms.git"
  },
  "keywords": [
    "sms",
    "nodejs",
    "api",
    "rocket",
    "gateway"
  ],
  "author": "Yauheni Pakala",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/yauhenipakala/node-rocketsms/issues"
  },
  "homepage": "https://github.com/yauhenipakala/node-rocketsms#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
