{
  "name": "node-rocketsms",
  "version": "0.2.2",
  "description": "Modern RocketSMS SMS-gateway API.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "coverage:report": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageReporters=lcov && open coverage/lcov-report/index.html",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yauhenipakala/node-rocketsms.git"
  },
  "keywords": [
    "sms",
    "nodejs",
    "api",
    "rocket",
    "gateway"
  ],
  "author": "Yauheni Pakala",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/yauhenipakala/node-rocketsms/issues"
  },
  "homepage": "https://github.com/yauhenipakala/node-rocketsms#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  }
}
